{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bash vercel-build.sh",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "functions": {
    "src/app/api/core/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/core/studios/audio/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/core/studios/video/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/melo/route.ts": {
      "maxDuration": 30
    }
  }
}
